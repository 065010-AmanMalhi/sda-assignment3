{
  "__inputs": [
    {
      "name": "DS_MYSQL",
      "label": "MySQL Data Source",
      "description": "Select the MySQL datasource containing the Assignment 3 market_data table.",
      "type": "datasource",
      "pluginId": "mysql",
      "pluginName": "MySQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "mysql",
      "name": "MySQL",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "barchart",
      "name": "Bar chart",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Live Price Trend",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "description": "Average one-minute close price for each selected NSE symbol.",
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(timestamp, '1m') AS time, symbol AS metric, AVG(close) AS close\nFROM market_data WHERE $__timeFilter(timestamp) AND exchange IN (${exchange:sqlstring}) AND symbol REGEXP '${symbol:regex}'\nGROUP BY time, symbol ORDER BY time",
          "refId": "A"
        }
      ],
      "transparent": false,
      "fieldConfig": {
        "defaults": {
          "unit": "currencyINR",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "title": "Streaming Volume",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "description": "Shares traded per one-minute interval.",
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(timestamp, '1m') AS time, SUM(volume) AS volume\nFROM market_data WHERE $__timeFilter(timestamp) AND exchange IN (${exchange:sqlstring}) AND symbol REGEXP '${symbol:regex}'\nGROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "transparent": false,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 65,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "Market Breadth",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "description": "Advancing, declining and unchanged market observations per minute.",
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(timestamp, '1m') AS time,\nSUM(CASE WHEN pct_change > 0 THEN 1 ELSE 0 END) AS advancing,\nSUM(CASE WHEN pct_change < 0 THEN 1 ELSE 0 END) AS declining,\nSUM(CASE WHEN pct_change = 0 THEN 1 ELSE 0 END) AS unchanged\nFROM market_data WHERE $__timeFilter(timestamp) AND exchange IN (${exchange:sqlstring}) AND symbol REGEXP '${symbol:regex}'\nGROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "transparent": false,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 45,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Market Momentum",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "description": "Average percentage change across the selected symbols.",
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(timestamp, '1m') AS time, AVG(pct_change) AS avg_pct_change\nFROM market_data WHERE $__timeFilter(timestamp) AND exchange IN (${exchange:sqlstring}) AND symbol REGEXP '${symbol:regex}'\nGROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "transparent": false,
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "title": "Top Symbols by Traded Volume",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "description": "Top symbols ranked by shares traded in the selected time range.",
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "format": "time_series",
          "rawSql": "SELECT symbol, SUM(volume) AS total_volume\nFROM market_data WHERE $__timeFilter(timestamp) AND exchange IN (${exchange:sqlstring}) AND symbol REGEXP '${symbol:regex}'\nGROUP BY symbol ORDER BY total_volume DESC LIMIT 10",
          "refId": "A"
        }
      ],
      "transparent": false,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "legend": {
          "displayMode": "hidden"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "title": "Biggest Price Movers",
      "type": "barchart",
      "gridPos": {
        "x": 8,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "description": "Symbols with the largest absolute average percentage movement.",
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "format": "time_series",
          "rawSql": "SELECT symbol, ROUND(AVG(pct_change), 2) AS avg_pct_change\nFROM market_data WHERE $__timeFilter(timestamp) AND exchange IN (${exchange:sqlstring}) AND symbol REGEXP '${symbol:regex}'\nGROUP BY symbol ORDER BY ABS(avg_pct_change) DESC LIMIT 10",
          "refId": "A"
        }
      ],
      "transparent": false,
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "legend": {
          "displayMode": "hidden"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 7,
      "title": "Intraday Range & Volatility",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "description": "Average high-low range as a percentage of close, used as a streaming volatility proxy.",
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(timestamp, '1m') AS time,\nAVG((high - low) / NULLIF(close,0) * 100) AS range_pct\nFROM market_data WHERE $__timeFilter(timestamp) AND exchange IN (${exchange:sqlstring}) AND symbol REGEXP '${symbol:regex}'\nGROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "transparent": false,
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 8,
      "title": "Large-Move Monitor",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "description": "Maximum absolute percentage move per minute. Elevated values flag unusual market movement.",
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(timestamp, '1m') AS time, MAX(ABS(pct_change)) AS max_abs_move\nFROM market_data WHERE $__timeFilter(timestamp) AND exchange IN (${exchange:sqlstring}) AND symbol REGEXP '${symbol:regex}'\nGROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "transparent": false,
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 9,
      "title": "Streamed Observations",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "description": "Number of market records in the selected time range.",
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "format": "time_series",
          "rawSql": "SELECT COUNT(*) AS observations FROM market_data\nWHERE $__timeFilter(timestamp) AND exchange IN (${exchange:sqlstring}) AND symbol REGEXP '${symbol:regex}'",
          "refId": "A"
        }
      ],
      "transparent": false,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "auto"
      }
    },
    {
      "id": 10,
      "title": "Average Close",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "description": "Average closing price across selected observations.",
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "format": "time_series",
          "rawSql": "SELECT AVG(close) AS avg_close FROM market_data\nWHERE $__timeFilter(timestamp) AND exchange IN (${exchange:sqlstring}) AND symbol REGEXP '${symbol:regex}'",
          "refId": "A"
        }
      ],
      "transparent": false,
      "fieldConfig": {
        "defaults": {
          "unit": "currencyINR",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "auto"
      }
    },
    {
      "id": 11,
      "title": "Peak Absolute Move",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 23,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "description": "Largest absolute percentage move recorded in the selected range.",
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "format": "time_series",
          "rawSql": "SELECT MAX(ABS(pct_change)) AS peak_move FROM market_data\nWHERE $__timeFilter(timestamp) AND exchange IN (${exchange:sqlstring}) AND symbol REGEXP '${symbol:regex}'",
          "refId": "A"
        }
      ],
      "transparent": false,
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "auto"
      }
    },
    {
      "id": 12,
      "title": "Live Market Tape",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "description": "Latest 50 market records, useful for demonstrating that the dashboard is receiving streamed data.",
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "format": "table",
          "rawSql": "SELECT timestamp, symbol, open, high, low, close, volume, pct_change, exchange\nFROM market_data WHERE $__timeFilter(timestamp) AND exchange IN (${exchange:sqlstring}) AND symbol REGEXP '${symbol:regex}'\nORDER BY timestamp DESC LIMIT 50",
          "refId": "T"
        }
      ],
      "transparent": false,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pct_change"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "open"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyINR"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "high"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyINR"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "low"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyINR"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "close"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyINR"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "timestamp",
            "desc": true
          }
        ]
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": [
    "SDA",
    "Streaming Data Analytics",
    "NSE",
    "Kafka",
    "Finance"
  ],
  "templating": {
    "list": [
      {
        "name": "symbol",
        "label": "Symbol",
        "type": "query",
        "datasource": {
          "type": "mysql",
          "uid": "${DS_MYSQL}"
        },
        "definition": "SELECT DISTINCT symbol FROM market_data ORDER BY symbol",
        "query": "SELECT DISTINCT symbol FROM market_data ORDER BY symbol",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "exchange",
        "label": "Exchange",
        "type": "query",
        "datasource": {
          "type": "mysql",
          "uid": "${DS_MYSQL}"
        },
        "definition": "SELECT DISTINCT exchange FROM market_data ORDER BY exchange",
        "query": "SELECT DISTINCT exchange FROM market_data ORDER BY exchange",
        "includeAll": true,
        "allValue": "NSE",
        "multi": false,
        "refresh": 1,
        "sort": 1,
        "current": {
          "text": "NSE",
          "value": "NSE"
        }
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "5m",
      "15m",
      "30m",
      "1h",
      "6h",
      "12h",
      "24h"
    ]
  },
  "timezone": "browser",
  "title": "NSE StreamPulse | Real-Time Market Intelligence",
  "uid": "nse-stream-pulse",
  "version": 1,
  "description": "Real-time NSE equity streaming dashboard for SDA Assignment 3, based on the nse-equity-ticks stream and market_data MySQL table."
}